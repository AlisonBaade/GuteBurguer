# ==========================================
# GUTE BURGUER - AMBIENTE LOCAL
# ==========================================
# Copie este arquivo para .env caso queira personalizar a execução local.
# Nenhum valor abaixo corresponde ao ambiente de produção.

# Django
DEBUG=True
SECRET_KEY=django-insecure-local-development-key
VISITOR_HASH_KEY=local-development-hash-key
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ADMIN_URL=gute-admin

# Banco PostgreSQL utilizado pelo docker-compose.yml
POSTGRES_DB=gute_db
POSTGRES_USER=gute_user
POSTGRES_PASSWORD=gute_password
DB_HOST=db
DB_PORT=5432

# CORS para o frontend Vite local
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend
VITE_API_URL=http://localhost:8000

# Dados demonstrativos. Substitua localmente se desejar testar a integração.
VITE_WHATSAPP_NUMBER=5500000000000
VITE_WHATSAPP_DISPLAY=(00) 00000-0000

# Estatísticas
ACCESS_LOG_RETENTION_DAYS=90
ACCESS_REGISTRATION_RATE=30/min
